{
  "name": "daedalus-data",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexv710/daedalusData.git"
  },
  "scripts": {
    "postinstall": "nuxi prepare",
    "build": "nuxi build",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxi dev",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "lint:ci": "eslint --ignore-pattern '.nuxt/**' --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts' .",
    "lint:fix": "eslint --ignore-pattern '.nuxt/**' --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts' --fix .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "commit": "cz"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "maxrects-packer": "^2.7.3",
    "sharp": "^0.35.0",
    "three": "^0.182.0",
    "uuid": "^14.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.6",
    "@iconify-json/twemoji": "^1.2.2",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.11.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@unocss/eslint-config": "^66.10.5",
    "@unocss/nuxt": "^66.10.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^14.4.0",
    "commitizen": "^4.3.2",
    "consola": "^3.4.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "jsdom": "^27.4.0",
    "nuxt": "4.5.2",
    "pinia": "^3.0.4",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^2.2.0",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
